<UserControl x:Class="WPF.Lib.Controls.Controls.BusyOverlay"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanVisibilityConverter" />
    </UserControl.Resources>
    <Grid>
        <ContentPresenter Content="{Binding Child, ElementName=Root}"
                          ContentTemplate="{Binding ChildTemplate, ElementName=Root}" />
        <Border Panel.ZIndex="100"
                Background="{DynamicResource OverlayBrush}"
                IsHitTestVisible="{Binding IsBusy, ElementName=Root}"
                Visibility="{Binding IsBusy, ElementName=Root, Converter={StaticResource BooleanVisibilityConverter}}">
            <Border Width="240"
                    Padding="20,16"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10">
                <StackPanel>
                    <TextBlock HorizontalAlignment="Center"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource ForegroundBrush}"
                               Text="{Binding BusyMessage, ElementName=Root}"
                               TextAlignment="Center"
                               TextWrapping="Wrap" />
                    <ProgressBar Height="6"
                                 Margin="0,12,0,0"
                                 IsIndeterminate="{Binding IsIndeterminate, ElementName=Root}"
                                 Maximum="100"
                                 Value="{Binding Progress, ElementName=Root}" />
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
