<UserControl x:Class="WPF.Lib.Controls.Controls.ColorPicker"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:WPF.Lib.Controls.Controls"
             MinWidth="140" MinHeight="32"
             Foreground="{DynamicResource ForegroundBrush}">
    <UserControl.Resources>
        <DrawingBrush x:Key="CheckerBrush" TileMode="Tile" Viewport="0,0,10,10" ViewportUnits="Absolute">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="{DynamicResource SurfaceBrush}" Geometry="M0,0 H10 V10 H0 Z" />
                    <GeometryDrawing Brush="{DynamicResource BorderBrush}" Geometry="M0,0 H5 V5 H0 Z M5,5 H10 V10 H5 Z" />
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>
        <LinearGradientBrush x:Key="HueBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Offset="0" Color="#FFFF0000" />
            <GradientStop Offset="0.1667" Color="#FFFFFF00" />
            <GradientStop Offset="0.3333" Color="#FF00FF00" />
            <GradientStop Offset="0.5" Color="#FF00FFFF" />
            <GradientStop Offset="0.6667" Color="#FF0000FF" />
            <GradientStop Offset="0.8333" Color="#FFFF00FF" />
            <GradientStop Offset="1" Color="#FFFF0000" />
        </LinearGradientBrush>
        <Style x:Key="PickerToggleStyle" TargetType="ToggleButton">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="7,3" />
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="ButtonBorder" Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <ToggleButton x:Name="DropDownButton" IsChecked="{Binding IsDropDownOpen, ElementName=Root}"
                      Style="{StaticResource PickerToggleStyle}" AutomationProperties.Name="색상 선택">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="28" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="18" />
                </Grid.ColumnDefinitions>
                <Border Height="24" Background="{StaticResource CheckerBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="3">
                    <Border CornerRadius="2">
                        <Border.Background><SolidColorBrush Color="{Binding SelectedColor, ElementName=Root}" /></Border.Background>
                    </Border>
                </Border>
                <TextBlock x:Name="CollapsedHex" Grid.Column="1" Margin="9,0" VerticalAlignment="Center" />
                <Path Grid.Column="2" Width="8" Height="5" HorizontalAlignment="Center" VerticalAlignment="Center"
                      Fill="{DynamicResource TextSecondaryBrush}" Data="M0,0 L8,0 L4,5 Z" />
            </Grid>
        </ToggleButton>

        <Popup x:Name="PickerPopup" AllowsTransparency="True" StaysOpen="False"
               Placement="Bottom" PlacementTarget="{Binding ElementName=DropDownButton}"
               IsOpen="{Binding IsDropDownOpen, ElementName=Root, Mode=TwoWay}"
               Opened="OnPopupOpened">
            <Border Width="350" Margin="0,4,0,6" Padding="12"
                    Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="8">
                <Border.Effect><DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.22" /></Border.Effect>
                <StackPanel KeyboardNavigation.TabNavigation="Cycle">
                    <TextBlock Margin="0,0,0,6" FontWeight="SemiBold" Text="색상" />
                    <Grid Height="165">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="24" />
                        </Grid.ColumnDefinitions>
                        <Canvas x:Name="ColorArea" Background="{Binding CurrentHueBrush, ElementName=Root}"
                                Cursor="Cross" ClipToBounds="True"
                                MouseLeftButtonDown="OnColorAreaMouseDown" MouseMove="OnColorAreaMouseMove"
                                MouseLeftButtonUp="OnPickerMouseUp">
                            <Rectangle Width="{Binding ActualWidth, ElementName=ColorArea}" Height="{Binding ActualHeight, ElementName=ColorArea}">
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Offset="0" Color="White" />
                                        <GradientStop Offset="1" Color="#00FFFFFF" />
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>
                            <Rectangle Width="{Binding ActualWidth, ElementName=ColorArea}" Height="{Binding ActualHeight, ElementName=ColorArea}">
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Offset="0" Color="#00000000" />
                                        <GradientStop Offset="1" Color="Black" />
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>
                            <Ellipse x:Name="ColorIndicator" Width="14" Height="14" IsHitTestVisible="False"
                                     Stroke="White" StrokeThickness="2" Fill="Transparent">
                                <Ellipse.Effect><DropShadowEffect BlurRadius="2" ShadowDepth="0" Opacity="0.9" /></Ellipse.Effect>
                            </Ellipse>
                        </Canvas>
                        <Canvas x:Name="HueArea" Grid.Column="2" Background="{StaticResource HueBrush}"
                                Cursor="SizeNS" ClipToBounds="True"
                                MouseLeftButtonDown="OnHueMouseDown" MouseMove="OnHueMouseMove"
                                MouseLeftButtonUp="OnPickerMouseUp">
                            <Rectangle x:Name="HueIndicator" Width="24" Height="4" IsHitTestVisible="False"
                                       Fill="Transparent" Stroke="White" StrokeThickness="2">
                                <Rectangle.Effect><DropShadowEffect BlurRadius="2" ShadowDepth="0" Opacity="0.9" /></Rectangle.Effect>
                            </Rectangle>
                        </Canvas>
                    </Grid>

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="55" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="55" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="6" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock VerticalAlignment="Center" Text="빨강(R)" />
                        <local:NumericUpDown x:Name="RedInput" Grid.Column="1" Minimum="0" Maximum="255" ValueChanged="OnRgbValueChanged" />
                        <TextBlock Grid.Column="3" VerticalAlignment="Center" Text="녹색(G)" />
                        <local:NumericUpDown x:Name="GreenInput" Grid.Column="4" Minimum="0" Maximum="255" ValueChanged="OnRgbValueChanged" />
                        <TextBlock Grid.Row="2" VerticalAlignment="Center" Text="파랑(B)" />
                        <local:NumericUpDown x:Name="BlueInput" Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="255" ValueChanged="OnRgbValueChanged" />
                        <TextBlock Grid.Row="2" Grid.Column="3" VerticalAlignment="Center" Text="알파(A)" />
                        <local:NumericUpDown x:Name="AlphaInput" Grid.Row="2" Grid.Column="4" Minimum="0" Maximum="255" ValueChanged="OnRgbValueChanged" />
                    </Grid>

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="55" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" Text="16진수(H)" />
                        <TextBox x:Name="HexInput" Grid.Column="1" MaxLength="9"
                                 AutomationProperties.Name="HEX 색상" ToolTip="#RRGGBB 또는 #AARRGGBB"
                                 PreviewKeyDown="OnHexKeyDown" LostKeyboardFocus="OnHexLostFocus" />
                    </Grid>
                    <TextBlock x:Name="HexError" Margin="55,5,0,0" Visibility="Collapsed"
                               Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap"
                               Text="#RRGGBB 또는 #AARRGGBB 형식으로 입력하세요." />
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
