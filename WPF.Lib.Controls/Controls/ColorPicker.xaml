<UserControl x:Class="WPF.Lib.Controls.Controls.ColorPicker"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="260"
             Foreground="{DynamicResource ForegroundBrush}">
    <UserControl.Resources>
        <Style x:Key="AlphaTrackButtonStyle" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent">
                            <Border Height="6" Background="{TemplateBinding Background}" CornerRadius="3" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="AlphaSliderStyle" TargetType="Slider">
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid>
                            <Border x:Name="FocusBorder" BorderBrush="Transparent" BorderThickness="1" CornerRadius="4" />
                            <Track x:Name="PART_Track" Margin="2,0">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Background="{DynamicResource PrimaryBrush}"
                                                  Style="{StaticResource AlphaTrackButtonStyle}" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="18" Height="18">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse x:Name="Handle" Fill="{DynamicResource PrimaryBrush}"
                                                         Stroke="{DynamicResource SurfaceBrush}" StrokeThickness="2" />
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Handle" Property="Fill" Value="{DynamicResource PrimaryHoverBrush}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Background="{DynamicResource BorderBrush}"
                                                  Style="{StaticResource AlphaTrackButtonStyle}" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="FocusBorder" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <DrawingBrush x:Key="CheckerBrush" TileMode="Tile" Viewport="0,0,12,12" ViewportUnits="Absolute">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="{DynamicResource SurfaceBrush}" Geometry="M0,0 H12 V12 H0 Z" />
                    <GeometryDrawing Brush="{DynamicResource BorderBrush}" Geometry="M0,0 H6 V6 H0 Z M6,6 H12 V12 H6 Z" />
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>
        <Style x:Key="SwatchStyle" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="2" />
            <Setter Property="Padding" Value="3" />
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
            <Setter Property="ToolTip" Value="{Binding}" />
            <Setter Property="AutomationProperties.Name" Value="{Binding}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Frame" Padding="{TemplateBinding Padding}" BorderThickness="2"
                                BorderBrush="Transparent" Background="Transparent" CornerRadius="5">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Frame" Property="Background" Value="{DynamicResource HoverBrush}" />
                                <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource TextSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource ForegroundBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Border Padding="14" Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="7">
        <Border.Style>
            <Style TargetType="Border">
                <Style.Triggers>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Opacity" Value="0.5" />
                    </Trigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="44" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Height="38" Background="{StaticResource CheckerBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                    <Border>
                        <Border.Background>
                            <SolidColorBrush Color="{Binding SelectedColor, ElementName=Root}" />
                        </Border.Background>
                    </Border>
                </Border>
                <TextBox x:Name="HexInput" Grid.Column="1" Margin="10,0,0,0"
                         Foreground="{DynamicResource ForegroundBrush}" MaxLength="9"
                         AutomationProperties.Name="HEX 색상" ToolTip="#RRGGBB 또는 #AARRGGBB"
                         PreviewKeyDown="OnHexKeyDown" LostKeyboardFocus="OnHexLostFocus" />
            </Grid>
            <TextBlock x:Name="HexError" Margin="0,6,0,0" Visibility="Collapsed"
                       Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap"
                       Text="#RRGGBB 또는 #AARRGGBB 형식으로 입력하세요." />
            <TextBlock Margin="0,12,0,4" Foreground="{DynamicResource TextSecondaryBrush}" Text="팔레트" />
            <ListBox x:Name="Palette" BorderThickness="0" Padding="0" Background="Transparent"
                     Foreground="{DynamicResource ForegroundBrush}" ItemContainerStyle="{StaticResource SwatchStyle}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     AutomationProperties.Name="색상 팔레트" SelectionChanged="OnPaletteSelectionChanged">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Width="24" Height="24" CornerRadius="3"
                                BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}">
                            <Border.Background><SolidColorBrush Color="{Binding}" /></Border.Background>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <DockPanel Margin="0,12,0,4">
                <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" Text="불투명도" />
                <TextBlock x:Name="OpacityLabel" HorizontalAlignment="Right" Foreground="{DynamicResource ForegroundBrush}" />
            </DockPanel>
            <Slider x:Name="AlphaSlider" Minimum="0" Maximum="255" TickFrequency="1"
                    Style="{StaticResource AlphaSliderStyle}"
                    IsSnapToTickEnabled="True" SmallChange="1" LargeChange="16"
                    AutomationProperties.Name="색상 불투명도" ValueChanged="OnAlphaChanged" />
        </StackPanel>
    </Border>
</UserControl>
