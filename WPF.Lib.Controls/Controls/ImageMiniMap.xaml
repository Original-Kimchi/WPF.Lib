<UserControl x:Class="WPF.Lib.Controls.Controls.ImageMiniMap"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Foreground="{DynamicResource ForegroundBrush}">
    <Border Padding="5"
            Background="{DynamicResource ImageViewerMiniMapBackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <Grid x:Name="MapSurface" Background="Transparent" ClipToBounds="True"
              SizeChanged="OnMapSizeChanged"
              MouseLeftButtonDown="OnMapMouseLeftButtonDown"
              MouseMove="OnMapMouseMove"
              MouseLeftButtonUp="OnMapMouseLeftButtonUp">
            <Image Source="{Binding Model.Source, ElementName=Root}" Stretch="Uniform" />
            <Canvas IsHitTestVisible="False">
                <Rectangle x:Name="ViewportRectangle" Visibility="Collapsed"
                           Stroke="{DynamicResource WarningBrush}" StrokeThickness="2"
                           Fill="{DynamicResource ImageViewerViewportFillBrush}" />
            </Canvas>
        </Grid>
    </Border>
</UserControl>
