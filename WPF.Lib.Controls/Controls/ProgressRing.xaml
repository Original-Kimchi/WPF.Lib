<UserControl x:Class="WPF.Lib.Controls.Controls.ProgressRing"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="32"
             Height="32"
             MinWidth="12"
             MinHeight="12"
             AutomationProperties.Name="Loading">
    <Viewbox Stretch="Uniform">
        <Grid Width="32" Height="32">
            <Ellipse Margin="2"
                     Opacity="0.18"
                     Stroke="{Binding RingBrush, ElementName=Root}"
                     StrokeThickness="{Binding RingThickness, ElementName=Root}" />
            <Ellipse x:Name="Indicator"
                     Margin="2"
                     RenderTransformOrigin="0.5,0.5"
                     Stroke="{Binding RingBrush, ElementName=Root}"
                     StrokeDashArray="8,22"
                     StrokeDashCap="Round"
                     StrokeThickness="{Binding RingThickness, ElementName=Root}">
                <Ellipse.RenderTransform>
                    <RotateTransform />
                </Ellipse.RenderTransform>
                <Ellipse.Style>
                    <Style TargetType="Ellipse">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsActive, ElementName=Root}" Value="True">
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard x:Name="RotationStoryboard">
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                             From="0"
                                                             To="360"
                                                             Duration="0:0:0.9" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                                <DataTrigger.ExitActions>
                                    <StopStoryboard BeginStoryboardName="RotationStoryboard" />
                                </DataTrigger.ExitActions>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Ellipse.Style>
            </Ellipse>
        </Grid>
    </Viewbox>
    <UserControl.Style>
        <Style TargetType="UserControl">
            <Setter Property="Visibility" Value="Visible" />
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45" />
                </Trigger>
                <DataTrigger Binding="{Binding IsActive, ElementName=Root}" Value="False">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Style>
</UserControl>
