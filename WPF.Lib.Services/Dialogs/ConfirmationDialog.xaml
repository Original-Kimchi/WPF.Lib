<theme:BaseDialogView x:Class="WPF.Lib.Services.Dialogs.ConfirmationDialog"
                      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      xmlns:theme="clr-namespace:WPF.Lib.Theme.Controls;assembly=WPF.Lib.Theme">
    <StackPanel>
        <TextBlock FontSize="18"
                   FontWeight="SemiBold"
                   Text="작업을 계속하시겠습니까?" />
        <TextBlock Margin="0,10,0,0"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   Text="{Binding Message}"
                   TextWrapping="Wrap" />
    </StackPanel>
</theme:BaseDialogView>
