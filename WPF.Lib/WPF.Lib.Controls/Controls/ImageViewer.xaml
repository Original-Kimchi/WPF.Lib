<UserControl x:Class="WPF.Lib.Controls.Controls.ImageViewer"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:WPF.Lib.Controls.Converters"
             xmlns:models="clr-namespace:WPF.Lib.Controls.Models"
             MinWidth="320" MinHeight="240">
    <UserControl.Resources>
        <converters:AnnotationKindToVisibilityConverter x:Key="KindVisibilityConverter" />
        <converters:MeasurementConverter x:Key="MeasurementConverter" />
        <converters:DrawingModeToBooleanConverter x:Key="DrawingModeToBooleanConverter" />
        <converters:InverseScaleConverter x:Key="InverseScaleConverter" />
        <BooleanToVisibilityConverter x:Key="BooleanVisibilityConverter" />
    </UserControl.Resources>

    <Grid Background="{DynamicResource SurfaceAlternateBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Padding="8" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <ToggleButton Margin="0,0,6,0" Padding="12,5" Content="이동"
                                  IsChecked="{Binding Model.DrawingMode, ElementName=Root, Mode=OneWay, Converter={StaticResource DrawingModeToBooleanConverter}, ConverterParameter=Pan}"
                                  Command="{Binding Model.SetDrawingModeCommand, ElementName=Root}" CommandParameter="Pan" />
                    <ToggleButton Margin="0,0,6,0" Padding="12,5" Content="선"
                                  IsChecked="{Binding Model.DrawingMode, ElementName=Root, Mode=OneWay, Converter={StaticResource DrawingModeToBooleanConverter}, ConverterParameter=Line}"
                                  Command="{Binding Model.SetDrawingModeCommand, ElementName=Root}" CommandParameter="Line" />
                    <ToggleButton Margin="0,0,6,0" Padding="12,5" Content="사각형"
                                  IsChecked="{Binding Model.DrawingMode, ElementName=Root, Mode=OneWay, Converter={StaticResource DrawingModeToBooleanConverter}, ConverterParameter=Rectangle}"
                                  Command="{Binding Model.SetDrawingModeCommand, ElementName=Root}" CommandParameter="Rectangle" />
                    <ToggleButton Margin="0,0,12,0" Padding="12,5" Content="원"
                                  IsChecked="{Binding Model.DrawingMode, ElementName=Root, Mode=OneWay, Converter={StaticResource DrawingModeToBooleanConverter}, ConverterParameter=Ellipse}"
                                  Command="{Binding Model.SetDrawingModeCommand, ElementName=Root}" CommandParameter="Ellipse" />
                    <Button Margin="0,0,6,0" Padding="12,5" Content="100%"
                            Command="{Binding Model.ResetScaleCommand, ElementName=Root}" />
                    <Button Margin="0,0,6,0" Padding="12,5" Content="맞춤"
                            Click="OnFitClick" />
                    <Button Padding="12,5" Content="선택 삭제"
                            Command="{Binding Model.DeleteSelectedCommand, ElementName=Root}" />
                </StackPanel>
                <TextBlock Margin="16,0,0,0" VerticalAlignment="Center" DockPanel.Dock="Right"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Text="{Binding Model.Scale, ElementName=Root, StringFormat={}{0:P0}}" />
            </DockPanel>
        </Border>

        <ScrollViewer x:Name="ImageScrollViewer" Grid.Row="1"
                      HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                      ScrollChanged="OnScrollChanged" PreviewMouseWheel="OnPreviewMouseWheel">
            <Grid x:Name="ImageSurface"
                  Width="{Binding Model.Source.Width, ElementName=Root}"
                  Height="{Binding Model.Source.Height, ElementName=Root}"
                  MouseLeftButtonDown="OnSurfaceMouseLeftButtonDown"
                  MouseMove="OnSurfaceMouseMove"
                  MouseLeftButtonUp="OnSurfaceMouseLeftButtonUp">
                <Grid.LayoutTransform>
                    <ScaleTransform ScaleX="{Binding Model.Scale, ElementName=Root}"
                                    ScaleY="{Binding Model.Scale, ElementName=Root}" />
                </Grid.LayoutTransform>
                <Image Source="{Binding Model.Source, ElementName=Root}" Stretch="Fill" />
                <Border Background="Transparent" />
                <ItemsControl ItemsSource="{Binding Model.Annotations, ElementName=Root}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><Canvas /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Canvas.Left" Value="0" />
                            <Setter Property="Canvas.Top" Value="0" />
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:ImageAnnotation}">
                            <Canvas Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    Height="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                                <Line X1="{Binding Start.X}" Y1="{Binding Start.Y}"
                                      X2="{Binding End.X}" Y2="{Binding End.Y}"
                                      Stroke="{Binding Stroke}" Fill="{Binding Fill}"
                                      StrokeThickness="{Binding StrokeThickness}" Opacity="{Binding Opacity}"
                                      StrokeDashArray="{Binding StrokeDashArray}"
                                      StrokeStartLineCap="{Binding StrokeStartLineCap}"
                                      StrokeEndLineCap="{Binding StrokeEndLineCap}"
                                      StrokeLineJoin="{Binding StrokeLineJoin}" Cursor="SizeAll"
                                      Visibility="{Binding Kind, Converter={StaticResource KindVisibilityConverter}, ConverterParameter=Line}" />
                                <Rectangle Canvas.Left="{Binding Left}" Canvas.Top="{Binding Top}"
                                           Width="{Binding Width}" Height="{Binding Height}"
                                           Stroke="{Binding Stroke}" Fill="{Binding Fill}"
                                           StrokeThickness="{Binding StrokeThickness}" Opacity="{Binding Opacity}"
                                           StrokeDashArray="{Binding StrokeDashArray}"
                                           StrokeLineJoin="{Binding StrokeLineJoin}" Cursor="SizeAll"
                                           Visibility="{Binding Kind, Converter={StaticResource KindVisibilityConverter}, ConverterParameter=Rectangle}" />
                                <Ellipse Canvas.Left="{Binding Left}" Canvas.Top="{Binding Top}"
                                         Width="{Binding Width}" Height="{Binding Height}"
                                         Stroke="{Binding Stroke}" Fill="{Binding Fill}"
                                         StrokeThickness="{Binding StrokeThickness}" Opacity="{Binding Opacity}"
                                         StrokeDashArray="{Binding StrokeDashArray}" Cursor="SizeAll"
                                         Visibility="{Binding Kind, Converter={StaticResource KindVisibilityConverter}, ConverterParameter=Ellipse}" />
                                <Border Canvas.Left="{Binding Left}" Canvas.Top="{Binding Top}" Margin="4,-24,0,0"
                                        Padding="5,2" Background="{Binding LabelBackground}"
                                        Opacity="{Binding LabelOpacity}" CornerRadius="3"
                                        Cursor="SizeAll"
                                        RenderTransformOrigin="0,1"
                                        Visibility="{Binding IsLabelVisible, Converter={StaticResource BooleanVisibilityConverter}}">
                                    <Border.RenderTransform>
                                        <ScaleTransform
                                            ScaleX="{Binding Model.Scale, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource InverseScaleConverter}}"
                                            ScaleY="{Binding Model.Scale, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource InverseScaleConverter}}" />
                                    </Border.RenderTransform>
                                    <TextBlock Foreground="{Binding LabelForeground}" FontSize="11">
                                        <TextBlock.Text>
                                            <MultiBinding Converter="{StaticResource MeasurementConverter}">
                                                <Binding Path="Kind" />
                                                <Binding Path="Width" />
                                                <Binding Path="Height" />
                                                <Binding Path="Length" />
                                                <Binding Path="Model.UnitsPerPixel" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                                <Binding Path="Model.MeasurementUnit" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </Border>
                                <Canvas Visibility="{Binding IsSelected, Converter={StaticResource BooleanVisibilityConverter}}">
                                    <Canvas.Resources>
                                        <Style TargetType="Rectangle">
                                            <Setter Property="Margin" Value="-5,-5,0,0" />
                                            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
                                            <Setter Property="RenderTransform">
                                                <Setter.Value>
                                                    <ScaleTransform
                                                        ScaleX="{Binding Model.Scale, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource InverseScaleConverter}}"
                                                        ScaleY="{Binding Model.Scale, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource InverseScaleConverter}}" />
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </Canvas.Resources>
                                    <Rectangle Canvas.Left="{Binding Start.X}" Canvas.Top="{Binding Start.Y}"
                                               Width="10" Height="10" Tag="ResizeStart"
                                               Cursor="SizeAll" Fill="White" Stroke="#FF2563EB" StrokeThickness="2"
                                               Visibility="{Binding Kind, Converter={StaticResource KindVisibilityConverter}, ConverterParameter=Line}" />
                                    <Rectangle Canvas.Left="{Binding End.X}" Canvas.Top="{Binding End.Y}"
                                               Width="10" Height="10" Tag="ResizeEnd"
                                               Cursor="SizeAll" Fill="White" Stroke="#FF2563EB" StrokeThickness="2"
                                               Visibility="{Binding Kind, Converter={StaticResource KindVisibilityConverter}, ConverterParameter=Line}" />
                                    <Rectangle Canvas.Left="{Binding Left}" Canvas.Top="{Binding Top}"
                                               Width="10" Height="10" Tag="ResizeTopLeft"
                                               Cursor="SizeNWSE" Fill="White" Stroke="#FF2563EB" StrokeThickness="2"
                                               Visibility="{Binding Kind, Converter={StaticResource KindVisibilityConverter}, ConverterParameter='Rectangle,Ellipse'}" />
                                    <Rectangle Canvas.Left="{Binding Left}" Canvas.Top="{Binding End.Y}"
                                               Width="10" Height="10" Tag="ResizeBottomLeft"
                                               Cursor="SizeNESW" Fill="White" Stroke="#FF2563EB" StrokeThickness="2"
                                               Visibility="{Binding Kind, Converter={StaticResource KindVisibilityConverter}, ConverterParameter='Rectangle,Ellipse'}" />
                                    <Rectangle Canvas.Left="{Binding End.X}" Canvas.Top="{Binding Top}"
                                               Width="10" Height="10" Tag="ResizeTopRight"
                                               Cursor="SizeNESW" Fill="White" Stroke="#FF2563EB" StrokeThickness="2"
                                               Visibility="{Binding Kind, Converter={StaticResource KindVisibilityConverter}, ConverterParameter='Rectangle,Ellipse'}" />
                                    <Rectangle Canvas.Left="{Binding End.X}" Canvas.Top="{Binding End.Y}"
                                               Width="10" Height="10" Tag="ResizeBottomRight"
                                               Cursor="SizeNWSE" Fill="White" Stroke="#FF2563EB" StrokeThickness="2"
                                               Visibility="{Binding Kind, Converter={StaticResource KindVisibilityConverter}, ConverterParameter='Rectangle,Ellipse'}" />
                                </Canvas>
                            </Canvas>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </ScrollViewer>

        <Border x:Name="MiniMap" Grid.Row="1" Width="190" Height="130" Margin="14"
                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Background="#CC111827" BorderBrush="#99FFFFFF" BorderThickness="1"
                MouseLeftButtonDown="OnMiniMapMouseLeftButtonDown">
            <Grid Margin="5">
                <Image Source="{Binding Model.Source, ElementName=Root}" Stretch="Uniform" />
                <Rectangle x:Name="MiniMapViewport" HorizontalAlignment="Left" VerticalAlignment="Top"
                           Stroke="#FFFFC107" StrokeThickness="2" Fill="#22FFC107" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
