<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/WPFControls.Theme;component/Styles/ModernControls.xaml" />
    </ResourceDictionary.MergedDictionaries>
    <Color x:Key="BackgroundColor">#FFF7F8FA</Color>
    <Color x:Key="SurfaceColor">#FFFFFFFF</Color>
    <Color x:Key="TextPrimaryColor">#FF1F2937</Color>
    <Color x:Key="TextSecondaryColor">#FF6B7280</Color>
    <Color x:Key="BorderColor">#FFD1D5DB</Color>
    <Color x:Key="PrimaryColor">#FF2563EB</Color>
    <Color x:Key="PrimaryHoverColor">#FF1D4ED8</Color>
    <Color x:Key="DangerColor">#FFDC2626</Color>
    <Color x:Key="SurfaceAlternateColor">#FFF9FAFB</Color>
    <Color x:Key="HeaderColor">#FFF3F4F6</Color>
    <Color x:Key="HoverColor">#FFEFF6FF</Color>
    <Color x:Key="SelectionColor">#FFDBEAFE</Color>

    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}" />
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="{StaticResource PrimaryHoverColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="SurfaceAlternateBrush" Color="{StaticResource SurfaceAlternateColor}" />
    <SolidColorBrush x:Key="HeaderBrush" Color="{StaticResource HeaderColor}" />
    <SolidColorBrush x:Key="HoverBrush" Color="{StaticResource HoverColor}" />
    <SolidColorBrush x:Key="SelectionBrush" Color="{StaticResource SelectionColor}" />
</ResourceDictionary>
