<Window x:Class="WPFControls.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WPF Controls Gallery"
        Width="1080"
        Height="720"
        MinWidth="820"
        MinHeight="560"
        Style="{StaticResource ModernWindowStyle}"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundBrush}">
    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="24" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock FontSize="26"
                           FontWeight="Bold"
                           Text="Modern WPF Controls" />
                <TextBlock Margin="0,6,0,0"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Text="Light and dark theme component gallery" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Margin="0,0,10,0" Text="Theme" />
                <ComboBox x:Name="ThemeSelector"
                          Width="130"
                          SelectedIndex="0"
                          SelectionChanged="ThemeSelector_SelectionChanged">
                    <ComboBoxItem Content="Light" Tag="Light" />
                    <ComboBoxItem Content="Dark" Tag="Dark" />
                </ComboBox>
            </StackPanel>
        </Grid>

        <TabControl Grid.Row="2">
            <TabItem Header="TextBox">
                <Border Padding="28"
                        Background="{DynamicResource SurfaceBrush}"
                        CornerRadius="0,10,10,10">
                    <StackPanel MaxWidth="600" HorizontalAlignment="Left">
                        <TextBlock FontSize="20" FontWeight="SemiBold" Text="Text input" />
                        <TextBlock Margin="0,6,0,22"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Text="Default, focused, multiline, and disabled states." />
                        <TextBlock Margin="0,0,0,7" FontWeight="SemiBold" Text="Email address" />
                        <TextBox Text="hello@example.com" />
                        <TextBlock Margin="0,18,0,7" FontWeight="SemiBold" Text="Description" />
                        <TextBox Height="110"
                                 AcceptsReturn="True"
                                 Text="A multiline TextBox uses the same theme resources."
                                 TextWrapping="Wrap"
                                 VerticalContentAlignment="Top" />
                        <TextBlock Margin="0,18,0,7" FontWeight="SemiBold" Text="Disabled" />
                        <TextBox IsEnabled="False" Text="This field is disabled" />
                        <Button Width="120" Margin="0,22,0,0" HorizontalAlignment="Left" Content="Save changes" />
                    </StackPanel>
                </Border>
            </TabItem>

            <TabItem Header="ListBox">
                <Border Padding="28"
                        Background="{DynamicResource SurfaceBrush}"
                        CornerRadius="0,10,10,10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <StackPanel Margin="0,0,0,20">
                            <TextBlock FontSize="20" FontWeight="SemiBold" Text="Project members" />
                            <TextBlock Margin="0,6,0,0"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Text="Select an item to preview selection and hover states." />
                        </StackPanel>
                        <ListBox Grid.Row="1" ItemsSource="{Binding Members}" SelectedIndex="0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="42" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="32" Height="32" CornerRadius="16" Background="{DynamicResource PrimaryBrush}">
                                            <TextBlock HorizontalAlignment="Center" Foreground="White" FontWeight="Bold" Text="{Binding Initials}" />
                                        </Border>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                                            <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Text="{Binding Email}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding Role}" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
            </TabItem>

            <TabItem Header="DataGrid">
                <Border Padding="28"
                        Background="{DynamicResource SurfaceBrush}"
                        CornerRadius="0,10,10,10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <StackPanel Margin="0,0,0,20">
                            <TextBlock FontSize="20" FontWeight="SemiBold" Text="Recent orders" />
                            <TextBlock Margin="0,6,0,0"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Text="A clean data table with alternating rows and full-row selection." />
                        </StackPanel>
                        <DataGrid Grid.Row="1"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  ItemsSource="{Binding Orders}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Width="110" Header="Order" Binding="{Binding Id}" />
                                <DataGridTextColumn Width="*" Header="Customer" Binding="{Binding Customer}" />
                                <DataGridTextColumn Width="150" Header="Date" Binding="{Binding Date}" />
                                <DataGridTextColumn Width="130" Header="Status" Binding="{Binding Status}" />
                                <DataGridTextColumn Width="120" Header="Total" Binding="{Binding Total}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
