<Window x:Class="WPFControls.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:viewModels="clr-namespace:WPFControls.UI.ViewModels"
        xmlns:views="clr-namespace:WPFControls.UI.Views"
        Title="WPF Controls"
        Width="1280"
        Height="820"
        MinWidth="900"
        MinHeight="620"
        Style="{StaticResource ModernWindowStyle}"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <DataTemplate DataType="{x:Type viewModels:MainViewModel}">
            <views:MainView />
        </DataTemplate>
    </Window.Resources>
    <Grid Background="{DynamicResource BackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Margin="20,22,20,18">
                    <TextBlock FontSize="20"
                               FontWeight="Bold"
                               Text="WPF Controls" />
                    <TextBlock Margin="0,4,0,0"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="Menu" />
                </StackPanel>

                <ListBox Grid.Row="1"
                         Margin="10,0,10,16"
                         BorderThickness="0"
                         ItemsSource="{Binding MenuItems}"
                         SelectedItem="{Binding SelectedMenu, Mode=TwoWay}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="4,2"
                                        Orientation="Horizontal">
                                <materialDesign:PackIcon Width="20"
                                                         Height="20"
                                                         Margin="0,0,12,0"
                                                         VerticalAlignment="Center"
                                                         Kind="{Binding Icon}" />
                                <TextBlock VerticalAlignment="Center"
                                           FontWeight="SemiBold"
                                           Text="{Binding Title}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <ContentControl Grid.Column="1"
                        Content="{Binding CurrentViewModel}" />
    </Grid>
</Window>
