<UserControl x:Class="WPFControls.UI.Views.ImageViewerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:WPF.Lib.Controls.Controls;assembly=WPF.Lib.Controls"
             xmlns:dragDrop="clr-namespace:WPF.Lib.Controls.DragDrop;assembly=WPF.Lib.Controls"
             Background="{DynamicResource BackgroundBrush}"
             dragDrop:DragDropBehavior.DropCommand="{Binding DropImageCommand}"
             dragDrop:DragDropBehavior.DropEffect="Copy"
             dragDrop:DragDropBehavior.IsDropTarget="True">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanVisibilityConverter" />
    </UserControl.Resources>
    <Grid Margin="32,28,32,32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock FontSize="28" FontWeight="Bold" Text="Image Viewer" />
            <TextBlock Margin="0,6,0,0" Foreground="{DynamicResource TextSecondaryBrush}"
                       Text="이미지 확대/축소 및 객체 측정" />
        </StackPanel>

        <Border Grid.Row="1" Margin="0,20,0,14" Padding="12"
                Background="{DynamicResource SurfaceBrush}" CornerRadius="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button MinWidth="110" Padding="14,7" Command="{Binding OpenImageCommand}" Content="이미지 열기" />
                <TextBox Grid.Column="1" Margin="12,0" VerticalContentAlignment="Center"
                         IsReadOnly="True" Text="{Binding ImagePath, Mode=OneWay}" />
                <TextBlock Grid.Column="2" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding StatusMessage}" />
            </Grid>
        </Border>

        <Border Grid.Row="2" Padding="1" Background="{DynamicResource BorderBrush}" CornerRadius="10">
            <controls:ImageViewer Model="{Binding Image}" />
        </Border>

        <Border x:Name="DropOverlay" Grid.Row="2" Panel.ZIndex="10"
                Margin="1" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource PrimaryBrush}" BorderThickness="2"
                CornerRadius="9" IsHitTestVisible="False" Opacity="0.94"
                Visibility="{Binding (dragDrop:DragDropBehavior.IsDragOver),
                                     RelativeSource={RelativeSource AncestorType=UserControl},
                                     Converter={StaticResource BooleanVisibilityConverter}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock HorizontalAlignment="Center" FontSize="32"
                           Foreground="{DynamicResource PrimaryBrush}" Text="↓" />
                <TextBlock Margin="0,8,0,0" FontSize="17" FontWeight="SemiBold"
                           Text="이미지 파일을 여기에 놓으세요" />
                <TextBlock Margin="0,5,0,0" HorizontalAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Text="PNG, JPG, BMP, GIF, TIFF" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
