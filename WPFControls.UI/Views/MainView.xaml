<UserControl x:Class="WPFControls.UI.Views.MainView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:WPF.Lib.Controls.Controls;assembly=WPF.Lib.Controls"
             Background="{DynamicResource BackgroundBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="32,28,32,22">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock FontSize="28" FontWeight="Bold" Text="WPF Controls Gallery" />
                <TextBlock Margin="0,6,0,0"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Text="테마에 기본 스타일이 적용된 모든 컨트롤" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Margin="0,0,10,0" VerticalAlignment="Center" Text="Theme" />
                <ComboBox Width="130"
                          ItemsSource="{Binding Themes}"
                          SelectedItem="{Binding SelectedTheme, Mode=TwoWay}" />
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="32,0,32,32">
                <Border Margin="0,0,0,20" Padding="24" Background="{DynamicResource SurfaceBrush}" CornerRadius="10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock FontSize="19" FontWeight="SemiBold" Text="Toast Notification" />
                            <TextBlock Margin="0,5,0,0" Foreground="{DynamicResource TextSecondaryBrush}"
                                       Text="화면을 막지 않는 자동 닫힘 알림입니다." />
                        </StackPanel>
                        <WrapPanel Grid.Column="1" Margin="24,0,0,0" VerticalAlignment="Center">
                            <Button Margin="0,0,8,0" Command="{Binding ShowInfoToastCommand}" Content="안내" />
                            <Button Margin="0,0,8,0" Command="{Binding ShowSuccessToastCommand}" Content="성공" />
                            <Button Margin="0,0,8,0" Command="{Binding ShowWarningToastCommand}" Content="주의" />
                            <Button Command="{Binding ShowErrorToastCommand}" Content="오류" />
                        </WrapPanel>
                    </Grid>
                </Border>
                <Border Padding="24"
                        Background="{DynamicResource SurfaceBrush}"
                        CornerRadius="10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock FontSize="19"
                                       FontWeight="SemiBold"
                                       Text="Confirmation Dialog" />
                            <TextBlock Margin="0,5,0,12"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Text="확인, 취소 및 우측 상단 닫기 버튼이 포함된 기본 다이얼로그입니다." />
                            <TextBlock
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Text="{Binding DialogResult}" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                MinWidth="132"
                                Margin="24,0,0,0"
                                VerticalAlignment="Center"
                                Command="{Binding ShowDialogCommand}"
                                Content="다이얼로그 열기" />
                    </Grid>
                </Border>

                <Grid Margin="0,20,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Padding="24" Background="{DynamicResource SurfaceBrush}" CornerRadius="10">
                        <StackPanel>
                            <TextBlock FontSize="19" FontWeight="SemiBold" Text="TextBlock &amp; Button" />
                            <TextBlock Margin="0,5,0,20"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Text="텍스트 계층과 버튼 상태" />
                            <TextBlock FontSize="24" FontWeight="Bold" Text="Heading text" />
                            <TextBlock Margin="0,6,0,18"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Text="Secondary text uses the shared theme brush." />
                            <WrapPanel>
                                <Button Margin="0,0,10,0" Content="Primary button" />
                                <Button IsEnabled="False" Content="Disabled button" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Padding="24" Background="{DynamicResource SurfaceBrush}" CornerRadius="10">
                        <StackPanel>
                            <TextBlock FontSize="19" FontWeight="SemiBold" Text="TextBox" />
                            <TextBlock Margin="0,5,0,20"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Text="한 줄, 여러 줄, 비활성 입력" />
                            <TextBlock Margin="0,0,0,7" FontWeight="SemiBold" Text="Email address" />
                            <TextBox Text="hello@example.com" />
                            <TextBox Height="76"
                                     Margin="0,12,0,0"
                                     AcceptsReturn="True"
                                     Text="Multiline text input"
                                     TextWrapping="Wrap"
                                     VerticalContentAlignment="Top" />
                            <TextBox Margin="0,12,0,0" IsEnabled="False" Text="Disabled input" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid Margin="0,20,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Padding="24" Background="{DynamicResource SurfaceBrush}" CornerRadius="10">
                        <StackPanel>
                            <TextBlock FontSize="19" FontWeight="SemiBold" Text="ComboBox" />
                            <TextBlock Margin="0,5,0,20"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Text="선택 항목과 드롭다운 항목 스타일" />
                            <ComboBox SelectedIndex="0">
                                <ComboBoxItem Content="Design" />
                                <ComboBoxItem Content="Development" />
                                <ComboBoxItem Content="Quality assurance" />
                            </ComboBox>
                            <ComboBox Margin="0,12,0,0" IsEnabled="False" SelectedIndex="0">
                                <ComboBoxItem Content="Disabled selection" />
                            </ComboBox>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Padding="24" Background="{DynamicResource SurfaceBrush}" CornerRadius="10">
                        <StackPanel>
                            <TextBlock FontSize="19" FontWeight="SemiBold" Text="TabControl" />
                            <TextBlock Margin="0,5,0,20"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Text="탭과 선택 상태" />
                            <TabControl Height="135" SelectedIndex="0">
                                <TabItem Header="Overview">
                                    <TextBlock Margin="18" Text="Overview tab content" />
                                </TabItem>
                                <TabItem Header="Details">
                                    <TextBlock Margin="18" Text="Details tab content" />
                                </TabItem>
                                <TabItem Header="Settings">
                                    <TextBlock Margin="18" Text="Settings tab content" />
                                </TabItem>
                            </TabControl>
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Margin="0,20,0,0" Padding="24" Background="{DynamicResource SurfaceBrush}" CornerRadius="10">
                    <StackPanel>
                        <TextBlock FontSize="19" FontWeight="SemiBold" Text="ListBox" />
                        <TextBlock Margin="0,5,0,20"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Text="항목, 마우스 오버, 선택 상태" />
                        <ListBox Height="190" ItemsSource="{Binding Members}" SelectedIndex="0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="44" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="32" Height="32" CornerRadius="16" Background="{DynamicResource PrimaryBrush}">
                                            <TextBlock HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource PrimaryForegroundBrush}"
                                                       FontWeight="Bold"
                                                       Text="{Binding Initials}" />
                                        </Border>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                                            <TextBlock FontSize="12"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       Text="{Binding Email}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   Text="{Binding Role}" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Border>

                <Border Margin="0,20,0,0" Padding="24" Background="{DynamicResource SurfaceBrush}" CornerRadius="10">
                    <StackPanel>
                        <TextBlock FontSize="19" FontWeight="SemiBold" Text="ScrollBar" />
                        <TextBlock Margin="0,5,0,20"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Text="가로·세로 방향과 Hover/Dragging 상태" />
                        <Grid Height="110">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ScrollBar VerticalAlignment="Center"
                                       Maximum="100"
                                       Orientation="Horizontal"
                                       Value="35"
                                       ViewportSize="25" />
                            <ScrollBar Grid.Column="2"
                                       Maximum="100"
                                       Orientation="Vertical"
                                       Value="35"
                                       ViewportSize="25" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Margin="0,20,0,0" Padding="24" Background="{DynamicResource SurfaceBrush}" CornerRadius="10">
                    <StackPanel>
                        <TextBlock FontSize="19" FontWeight="SemiBold" Text="DataGrid" />
                        <TextBlock Margin="0,5,0,20"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Text="헤더, 행, 셀, 교차 행과 전체 행 선택" />
                        <DataGrid Height="250"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  ItemsSource="{Binding Orders}"
                                  SelectedIndex="1">
                            <DataGrid.Columns>
                                <DataGridTextColumn Width="110" Header="Order" Binding="{Binding Id}" />
                                <DataGridTextColumn Width="*" Header="Customer" Binding="{Binding Customer}" />
                                <DataGridTextColumn Width="150" Header="Date" Binding="{Binding Date}" />
                                <DataGridTextColumn Width="140" Header="Status" Binding="{Binding Status}" />
                                <DataGridTextColumn Width="120"
                                                    Header="Total"
                                                    Binding="{Binding Total}"
                                                    CellStyle="{StaticResource DataGridCellRightStyle}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <Grid Margin="0,20,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Padding="24" Background="{DynamicResource SurfaceBrush}" CornerRadius="10">
                        <StackPanel>
                            <TextBlock FontSize="19" FontWeight="SemiBold" Text="Toggle &amp; Selection" />
                            <TextBlock Margin="0,5,0,20" Foreground="{DynamicResource TextSecondaryBrush}"
                                       Text="ToggleButton, CheckBox, RadioButton 상태" />
                            <WrapPanel Margin="0,0,0,18">
                                <ToggleButton Margin="0,0,8,0" Content="Default" />
                                <ToggleButton Margin="0,0,8,0" Content="Selected" IsChecked="True" />
                                <ToggleButton Content="Disabled" IsEnabled="False" />
                            </WrapPanel>
                            <CheckBox Margin="0,0,0,10" Content="Enable notifications" IsChecked="True" />
                            <CheckBox Margin="0,0,0,16" Content="Disabled option" IsEnabled="False" />
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Margin="0,0,18,0" Content="Option A" GroupName="GalleryOptions" IsChecked="True" />
                                <RadioButton Content="Option B" GroupName="GalleryOptions" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Padding="24" Background="{DynamicResource SurfaceBrush}" CornerRadius="10">
                        <StackPanel>
                            <TextBlock FontSize="19" FontWeight="SemiBold" Text="Password &amp; DatePicker" />
                            <TextBlock Margin="0,5,0,20" Foreground="{DynamicResource TextSecondaryBrush}"
                                       Text="보안 입력과 날짜 선택" />
                            <TextBlock Margin="0,0,0,7" FontWeight="SemiBold" Text="Password" />
                            <PasswordBox Password="password" />
                            <TextBlock Margin="0,16,0,7" FontWeight="SemiBold" Text="Date" />
                            <DatePicker SelectedDateFormat="Long" />
                            <DatePicker Margin="0,12,0,0" IsEnabled="False" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid Margin="0,20,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Padding="24" Background="{DynamicResource SurfaceBrush}" CornerRadius="10">
                        <StackPanel>
                            <TextBlock FontSize="19" FontWeight="SemiBold" Text="ProgressBar &amp; Slider" />
                            <TextBlock Margin="0,5,0,20" Foreground="{DynamicResource TextSecondaryBrush}"
                                       Text="진행 상태와 범위 값 선택" />
                            <TextBlock Margin="0,0,0,8" Text="Progress 68%" />
                            <ProgressBar Value="68" />
                            <TextBlock Margin="0,20,0,8" Text="Volume" />
                            <Slider Minimum="0" Maximum="100" Value="42" TickFrequency="10" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Padding="24" Background="{DynamicResource SurfaceBrush}" CornerRadius="10">
                        <StackPanel>
                            <TextBlock FontSize="19" FontWeight="SemiBold" Text="GroupBox &amp; Expander" />
                            <TextBlock Margin="0,5,0,12" Foreground="{DynamicResource TextSecondaryBrush}"
                                       Text="관련 콘텐츠 그룹과 접이식 영역" />
                            <GroupBox Header="Connection">
                                <StackPanel>
                                    <TextBlock Text="Server: localhost" />
                                    <TextBlock Margin="0,5,0,0" Foreground="{DynamicResource TextSecondaryBrush}" Text="Status: Connected" />
                                </StackPanel>
                            </GroupBox>
                            <Expander Margin="0,14,0,0" Header="Advanced settings" IsExpanded="True">
                                <TextBlock Text="Additional configuration content" />
                            </Expander>
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid Margin="0,20,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Padding="24" Background="{DynamicResource SurfaceBrush}" CornerRadius="10">
                        <StackPanel>
                            <TextBlock FontSize="19" FontWeight="SemiBold" Text="TreeView" />
                            <TextBlock Margin="0,5,0,14" Foreground="{DynamicResource TextSecondaryBrush}"
                                       Text="계층 구조, 확장 및 선택 상태" />
                            <TreeView Height="180">
                                <TreeViewItem Header="WPFControls.UI" IsExpanded="True">
                                    <TreeViewItem Header="Views" IsExpanded="True">
                                        <TreeViewItem Header="MainView.xaml" IsSelected="True" />
                                        <TreeViewItem Header="ImageViewerView.xaml" />
                                    </TreeViewItem>
                                    <TreeViewItem Header="ViewModels" />
                                    <TreeViewItem Header="Services" />
                                </TreeViewItem>
                            </TreeView>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Padding="24" Background="{DynamicResource SurfaceBrush}" CornerRadius="10">
                        <StackPanel>
                            <TextBlock FontSize="19" FontWeight="SemiBold" Text="Menu &amp; ContextMenu" />
                            <TextBlock Margin="0,5,0,14" Foreground="{DynamicResource TextSecondaryBrush}"
                                       Text="메뉴, 하위 메뉴 및 우클릭 메뉴" />
                            <Menu>
                                <MenuItem Header="File">
                                    <MenuItem Header="New" InputGestureText="Ctrl+N" />
                                    <MenuItem Header="Open" InputGestureText="Ctrl+O" />
                                    <Separator />
                                    <MenuItem Header="Exit" />
                                </MenuItem>
                                <MenuItem Header="Edit">
                                    <MenuItem Header="Copy" InputGestureText="Ctrl+C" />
                                    <MenuItem Header="Paste" InputGestureText="Ctrl+V" />
                                </MenuItem>
                            </Menu>
                            <Border Height="112" Margin="0,16,0,0" Background="{DynamicResource SurfaceAlternateBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="7">
                                <Border.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Refresh" />
                                        <MenuItem Header="Properties" />
                                    </ContextMenu>
                                </Border.ContextMenu>
                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondaryBrush}" Text="Right-click here" />
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>
        <controls:ToastHost Grid.RowSpan="2" Margin="0,20,20,0" Panel.ZIndex="100"
                            Service="{Binding ToastService}" />
    </Grid>
</UserControl>
