<UserControl x:Class="WPFControls.UI.Views.MainView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource BackgroundBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="32,28,32,22">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock FontSize="28" FontWeight="Bold" Text="WPF Controls Gallery" />
                <TextBlock Margin="0,6,0,0"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Text="테마에 기본 스타일이 적용된 모든 컨트롤" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Margin="0,0,10,0" VerticalAlignment="Center" Text="Theme" />
                <ComboBox Width="130"
                          ItemsSource="{Binding Themes}"
                          SelectedItem="{Binding SelectedTheme, Mode=TwoWay}" />
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="32,0,32,32">
                <Border Padding="24"
                        Background="{DynamicResource SurfaceBrush}"
                        CornerRadius="10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock FontSize="19"
                                       FontWeight="SemiBold"
                                       Text="Confirmation Dialog" />
                            <TextBlock Margin="0,5,0,12"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Text="확인, 취소 및 우측 상단 닫기 버튼이 포함된 기본 다이얼로그입니다." />
                            <TextBlock
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Text="{Binding DialogResult}" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                MinWidth="132"
                                Margin="24,0,0,0"
                                VerticalAlignment="Center"
                                Command="{Binding ShowDialogCommand}"
                                Content="다이얼로그 열기" />
                    </Grid>
                </Border>

                <Grid Margin="0,20,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Padding="24" Background="{DynamicResource SurfaceBrush}" CornerRadius="10">
                        <StackPanel>
                            <TextBlock FontSize="19" FontWeight="SemiBold" Text="TextBlock &amp; Button" />
                            <TextBlock Margin="0,5,0,20"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Text="텍스트 계층과 버튼 상태" />
                            <TextBlock FontSize="24" FontWeight="Bold" Text="Heading text" />
                            <TextBlock Margin="0,6,0,18"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Text="Secondary text uses the shared theme brush." />
                            <WrapPanel>
                                <Button Margin="0,0,10,0" Content="Primary button" />
                                <Button IsEnabled="False" Content="Disabled button" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Padding="24" Background="{DynamicResource SurfaceBrush}" CornerRadius="10">
                        <StackPanel>
                            <TextBlock FontSize="19" FontWeight="SemiBold" Text="TextBox" />
                            <TextBlock Margin="0,5,0,20"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Text="한 줄, 여러 줄, 비활성 입력" />
                            <TextBlock Margin="0,0,0,7" FontWeight="SemiBold" Text="Email address" />
                            <TextBox Text="hello@example.com" />
                            <TextBox Height="76"
                                     Margin="0,12,0,0"
                                     AcceptsReturn="True"
                                     Text="Multiline text input"
                                     TextWrapping="Wrap"
                                     VerticalContentAlignment="Top" />
                            <TextBox Margin="0,12,0,0" IsEnabled="False" Text="Disabled input" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid Margin="0,20,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Padding="24" Background="{DynamicResource SurfaceBrush}" CornerRadius="10">
                        <StackPanel>
                            <TextBlock FontSize="19" FontWeight="SemiBold" Text="ComboBox" />
                            <TextBlock Margin="0,5,0,20"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Text="선택 항목과 드롭다운 항목 스타일" />
                            <ComboBox SelectedIndex="0">
                                <ComboBoxItem Content="Design" />
                                <ComboBoxItem Content="Development" />
                                <ComboBoxItem Content="Quality assurance" />
                            </ComboBox>
                            <ComboBox Margin="0,12,0,0" IsEnabled="False" SelectedIndex="0">
                                <ComboBoxItem Content="Disabled selection" />
                            </ComboBox>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Padding="24" Background="{DynamicResource SurfaceBrush}" CornerRadius="10">
                        <StackPanel>
                            <TextBlock FontSize="19" FontWeight="SemiBold" Text="TabControl" />
                            <TextBlock Margin="0,5,0,20"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Text="탭과 선택 상태" />
                            <TabControl Height="135" SelectedIndex="0">
                                <TabItem Header="Overview">
                                    <TextBlock Margin="18" Text="Overview tab content" />
                                </TabItem>
                                <TabItem Header="Details">
                                    <TextBlock Margin="18" Text="Details tab content" />
                                </TabItem>
                                <TabItem Header="Settings">
                                    <TextBlock Margin="18" Text="Settings tab content" />
                                </TabItem>
                            </TabControl>
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Margin="0,20,0,0" Padding="24" Background="{DynamicResource SurfaceBrush}" CornerRadius="10">
                    <StackPanel>
                        <TextBlock FontSize="19" FontWeight="SemiBold" Text="ListBox" />
                        <TextBlock Margin="0,5,0,20"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Text="항목, 마우스 오버, 선택 상태" />
                        <ListBox Height="190" ItemsSource="{Binding Members}" SelectedIndex="0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="44" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="32" Height="32" CornerRadius="16" Background="{DynamicResource PrimaryBrush}">
                                            <TextBlock HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource PrimaryForegroundBrush}"
                                                       FontWeight="Bold"
                                                       Text="{Binding Initials}" />
                                        </Border>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                                            <TextBlock FontSize="12"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       Text="{Binding Email}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   Text="{Binding Role}" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Border>

                <Border Margin="0,20,0,0" Padding="24" Background="{DynamicResource SurfaceBrush}" CornerRadius="10">
                    <StackPanel>
                        <TextBlock FontSize="19" FontWeight="SemiBold" Text="ScrollBar" />
                        <TextBlock Margin="0,5,0,20"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Text="가로·세로 방향과 Hover/Dragging 상태" />
                        <Grid Height="110">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ScrollBar VerticalAlignment="Center"
                                       Maximum="100"
                                       Orientation="Horizontal"
                                       Value="35"
                                       ViewportSize="25" />
                            <ScrollBar Grid.Column="2"
                                       Maximum="100"
                                       Orientation="Vertical"
                                       Value="35"
                                       ViewportSize="25" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Margin="0,20,0,0" Padding="24" Background="{DynamicResource SurfaceBrush}" CornerRadius="10">
                    <StackPanel>
                        <TextBlock FontSize="19" FontWeight="SemiBold" Text="DataGrid" />
                        <TextBlock Margin="0,5,0,20"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Text="헤더, 행, 셀, 교차 행과 전체 행 선택" />
                        <DataGrid Height="250"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  ItemsSource="{Binding Orders}"
                                  SelectedIndex="1">
                            <DataGrid.Columns>
                                <DataGridTextColumn Width="110" Header="Order" Binding="{Binding Id}" />
                                <DataGridTextColumn Width="*" Header="Customer" Binding="{Binding Customer}" />
                                <DataGridTextColumn Width="150" Header="Date" Binding="{Binding Date}" />
                                <DataGridTextColumn Width="140" Header="Status" Binding="{Binding Status}" />
                                <DataGridTextColumn Width="120"
                                                    Header="Total"
                                                    Binding="{Binding Total}"
                                                    CellStyle="{StaticResource DataGridCellRightStyle}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
