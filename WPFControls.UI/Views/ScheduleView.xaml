<UserControl x:Class="WPFControls.UI.Views.ScheduleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:WPF.Lib.Controls.Controls;assembly=WPF.Lib.Controls"
             Background="{DynamicResource BackgroundBrush}">
    <UserControl.Resources>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Padding" Value="18" />
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="28,24,28,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="20" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock FontSize="28" FontWeight="Bold" Text="일정 관리" />
                <TextBlock Margin="0,5,0,0"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Text="날짜별 일정을 기록하고 한눈에 관리하세요." />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <ComboBox Margin="0,0,10,0"
                          ItemsSource="{Binding Themes}"
                          SelectedItem="{Binding SelectedTheme, Mode=TwoWay}" />
                <Button Command="{Binding TodayCommand}" Content="오늘" />
                <Button Margin="8,0,0,0"
                        Command="{Binding NewScheduleCommand}"
                        Content="+ 새 일정" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.95*" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="1.05*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="18" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Calendar
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Top"
                              DisplayDate="{Binding DisplayDate, Mode=TwoWay}"
                              SelectedDate="{Binding SelectedDate, Mode=TwoWay}"
                              SelectionMode="SingleDate" />
                </Grid>
            </Border>

            <Border Grid.Row="2" Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="16" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock FontSize="19" FontWeight="SemiBold" Text="{Binding SelectedDateTitle}" />
                            <TextBlock Margin="0,4,0,0" Foreground="{DynamicResource TextSecondaryBrush}"
                                       Text="{Binding ScheduleCountText}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Margin="0,0,8,0" Command="{Binding EditScheduleCommand}" Content="수정" />
                            <Button Command="{Binding DeleteScheduleCommand}" Content="삭제" />
                        </StackPanel>
                    </Grid>

                    <ListBox Grid.Row="2"
                             BorderThickness="0"
                             ItemsSource="{Binding DailySchedules}"
                             SelectedItem="{Binding SelectedSchedule, Mode=TwoWay}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="2,7" MinHeight="66" HorizontalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="5" />
                                        <ColumnDefinition Width="14" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Background="{DynamicResource PrimaryBrush}" CornerRadius="3" />
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <TextBlock FontSize="15" FontWeight="SemiBold" Text="{Binding Title}" />
                                        <StackPanel Margin="0,6,0,0" Orientation="Horizontal">
                                            <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding TimeRange}" />
                                            <TextBlock Margin="12,0,0,0" Foreground="{DynamicResource PrimaryBrush}" Text="{Binding Category}" />
                                        </StackPanel>
                                        <TextBlock Margin="0,4,0,0" TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding Notes}" />
                                    </StackPanel>
                                    <CheckBox Grid.Column="3" Margin="12,0,4,0" VerticalAlignment="Center"
                                              IsChecked="{Binding IsCompleted, Mode=OneWay}"
                                              Command="{Binding DataContext.ToggleCompletedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                              CommandParameter="{Binding}" ToolTip="완료 여부" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Grid.Row="3" Margin="0,12,0,0" HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="일정을 선택하면 수정하거나 삭제할 수 있습니다." />
                </Grid>
            </Border>

            <Border Grid.Column="2" Grid.RowSpan="3" Style="{StaticResource CardStyle}">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock FontSize="19" FontWeight="SemiBold" Text="{Binding EditorHeading}" />
                        <TextBlock Margin="0,18,0,7" FontWeight="SemiBold" Text="제목" />
                        <TextBox Text="{Binding EditorTitle, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Margin="0,15,0,7" FontWeight="SemiBold" Text="날짜" />
                        <DatePicker SelectedDate="{Binding EditorDate, Mode=TwoWay}" />

                        <TextBlock Margin="0,15,0,7" FontWeight="SemiBold" Text="시간" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="10" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Margin="0,0,12,0"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Text="시작" />
                            <controls:TimePicker Grid.Column="1"
                                                 HorizontalAlignment="Stretch"
                                                 MinuteStep="5"
                                                 SelectedTime="{Binding EditorStartTime, Mode=TwoWay}" />
                            <TextBlock Grid.Row="2" Margin="0,0,12,0"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Text="종료" />
                            <controls:TimePicker Grid.Row="2" Grid.Column="1"
                                                 HorizontalAlignment="Stretch"
                                                 MinuteStep="5"
                                                 SelectedTime="{Binding EditorEndTime, Mode=TwoWay}" />
                        </Grid>

                        <TextBlock Margin="0,15,0,7" FontWeight="SemiBold" Text="분류" />
                        <ComboBox ItemsSource="{Binding Categories}"
                                  SelectedItem="{Binding EditorCategory, Mode=TwoWay}" />

                        <TextBlock Margin="0,15,0,7" FontWeight="SemiBold" Text="메모" />
                        <TextBox Height="92" AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalContentAlignment="Top"
                                 Text="{Binding EditorNotes, UpdateSourceTrigger=PropertyChanged}" />

                        <Button Margin="0,20,0,0" Command="{Binding SaveScheduleCommand}" Content="일정 저장" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <controls:ToastHost Grid.RowSpan="3" Margin="0,16,16,0" Panel.ZIndex="100"
                            Service="{Binding ToastService}" />
    </Grid>
</UserControl>
